        "checkout": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Checkout — WoollyCraft</title><link rel=\"stylesheet\" href=\"/customer/assets/store.css\"></head><body><header class=\"header\"><div class=\"container nav\"><a class=\"logo\" href=\"/\">🧶 WoollyCraft</a><nav class=\"navlinks\"><a href=\"/\">Home</a><a href=\"/customer/pages/shop.html\">Shop</a><a href=\"/customer/pages/wishlist.html\">♡ Wishlist</a><a href=\"/customer/pages/cart.html\">🛒 Cart <span data-count>0</span></a><a href=\"/customer/pages/orders.html\">Orders</a><a href=\"/customer/pages/profile.html\">Account</a></nav></div></header><main class=\"container page\"><span class=\"eyebrow\">SECURE CHECKOUT</span><h1>Complete your order</h1><div data-checkout></div></main><footer class=\"footer\"><div class=\"container\"><b>🧶 WoollyCraft</b><p>Little handmade things, made to make you smile.</p></div></footer><nav class=\"mobile\"><a href=\"/\">🏠<br>Home</a><a href=\"/customer/pages/shop.html\">🛍<br>Shop</a><a href=\"/customer/pages/wishlist.html\">♡<br>Wish</a><a href=\"/customer/pages/cart.html\">🛒<br>Cart</a><a href=\"/customer/pages/profile.html\">👤<br>Account</a></nav><script src=\"/customer/components/store.js\"></script></body></html>",
        "orders": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>My Orders — WoollyCraft</title><link rel=\"stylesheet\" href=\"/customer/assets/store.css\"></head><body><header class=\"header\"><div class=\"container nav\"><a class=\"logo\" href=\"/\">🧶 WoollyCraft</a><nav class=\"navlinks\"><a href=\"/\">Home</a><a href=\"/customer/pages/shop.html\">Shop</a><a href=\"/customer/pages/wishlist.html\">♡ Wishlist</a><a href=\"/customer/pages/cart.html\">🛒 Cart <span data-count>0</span></a><a href=\"/customer/pages/orders.html\">Orders</a><a href=\"/customer/pages/profile.html\">Account</a></nav></div></header><main class=\"container page\"><span class=\"eyebrow\">ACCOUNT</span><h1>My Orders</h1><div id=\"orders\" class=\"panel\">Loading your orders...</div></main><footer class=\"footer\"><div class=\"container\"><b>🧶 WoollyCraft</b><p>Little handmade things, made to make you smile.</p></div></footer><nav class=\"mobile\"><a href=\"/\">🏠<br>Home</a><a href=\"/customer/pages/shop.html\">🛍<br>Shop</a><a href=\"/customer/pages/wishlist.html\">♡<br>Wish</a><a href=\"/customer/pages/cart.html\">🛒<br>Cart</a><a href=\"/customer/pages/profile.html\">👤<br>Account</a></nav><script src=\"/customer/components/store.js\"></script><script>\nconst cid=localStorage.woolly_customer_id;const moneyO=n=>'₹'+Number(n||0).toLocaleString('en-IN');const escO=s=>String(s??'').replace(/[&<>'\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',\"'\":'&#39;','\"':'&quot;'}[c]));\nasync function loadMyOrders(){const el=document.getElementById('orders');try{const d=await (await fetch('/api/customer/orders?customerId='+encodeURIComponent(cid||''))).json();const orders=d.orders||[];const id=new URLSearchParams(location.search).get('id');if(!orders.length){el.innerHTML='<div class=\"empty\"><h2>No orders yet</h2><a class=\"btn primary\" href=\"/customer/pages/shop.html\">Start shopping</a></div>';return}const selected=id?orders.find(x=>x.id===id):null;if(selected){el.innerHTML=`<div class=\"order-detail\"><div style=\"display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap\"><div><h2>${escO(selected.id)}</h2><p>${new Date(selected.createdAt||Date.now()).toLocaleString('en-IN')} · <b>${escO(selected.status||'confirmed')}</b></p></div><a class=\"btn light\" href=\"/customer/pages/track-order.html?id=${encodeURIComponent(selected.id)}\">Track order</a></div><hr>${(selected.items||[]).map(i=>`<a class=\"cart-row\" style=\"display:flex;text-decoration:none;color:inherit\" href=\"/customer/pages/product.html?id=${encodeURIComponent(i.id)}\"><img src=\"${escO(i.image||'https://placehold.co/120x120')}\" alt=\"\"><div style=\"flex:1\"><b>${escO(i.name)}</b><p>Product No: ${escO(i.sku||'—')} · Qty ${i.qty}</p><b>${moneyO(Number(i.price||0)*Number(i.qty||0))}</b><div class=\"muted\">Click to open product →</div></div></a>`).join('')}<div class=\"summary\"><div class=\"line\"><span>Subtotal</span><b>${moneyO(selected.subtotal)}</b></div><div class=\"line\"><span>Shipping</span><b>${moneyO(selected.shipping)}</b></div><div class=\"line total\"><span>Total</span><b>${moneyO(selected.total||selected.amount)}</b></div></div></div>`;return}el.innerHTML=`<div class=\"order-list\">${orders.map(x=>`<div class=\"mini\" style=\"margin-bottom:10px\"><div style=\"display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap\"><div><h3>${escO(x.id)}</h3><span>${new Date(x.createdAt||Date.now()).toLocaleString('en-IN')} · ${escO(x.status||'confirmed')}</span></div><b>${moneyO(x.total||x.amount)}</b></div><p>${(x.items||[]).length} item(s): ${(x.items||[]).slice(0,3).map(i=>escO(i.name)).join(', ')}</p><div class=\"actions\"><a class=\"btn primary\" href=\"/customer/pages/orders.html?id=${encodeURIComponent(x.id)}\">View items</a><a class=\"btn light\" href=\"/customer/pages/track-order.html?id=${encodeURIComponent(x.id)}\">Track</a></div></div>`).join('')}</div>`}catch(e){el.innerHTML='<p class=\"error\">Unable to load orders.</p>'}}loadMyOrders();\n</script></body></html>",
        "order-confirmation": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Order confirmed — WoollyCraft</title><link rel=\"stylesheet\" href=\"/customer/assets/store.css\"></head><body><header class=\"header\"><div class=\"container nav\"><a class=\"logo\" href=\"/\">🧶 WoollyCraft</a><nav class=\"navlinks\"><a href=\"/\">Home</a><a href=\"/customer/pages/shop.html\">Shop</a><a href=\"/customer/pages/wishlist.html\">♡ Wishlist</a><a href=\"/customer/pages/cart.html\">🛒 Cart <span data-count>0</span></a><a href=\"/customer/pages/orders.html\">Orders</a><a href=\"/customer/pages/profile.html\">Account</a></nav></div></header><main class=\"container page\"><div data-confirm></div></main><footer class=\"footer\"><div class=\"container\"><b>🧶 WoollyCraft</b><p>Little handmade things, made to make you smile.</p></div></footer><nav class=\"mobile\"><a href=\"/\">🏠<br>Home</a><a href=\"/customer/pages/shop.html\">🛍<br>Shop</a><a href=\"/customer/pages/wishlist.html\">♡<br>Wish</a><a href=\"/customer/pages/cart.html\">🛒<br>Cart</a><a href=\"/customer/pages/profile.html\">👤<br>Account</a></nav><script src=\"/customer/components/store.js\"></script></body></html>",
        "track-order": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Track Order — WoollyCraft</title><link rel=\"stylesheet\" href=\"/customer/assets/store.css\"></head><body><header class=\"header\"><div class=\"container nav\"><a class=\"logo\" href=\"/\">🧶 WoollyCraft</a><nav class=\"navlinks\"><a href=\"/\">Home</a><a href=\"/customer/pages/shop.html\">Shop</a><a href=\"/customer/pages/wishlist.html\">♡ Wishlist</a><a href=\"/customer/pages/cart.html\">🛒 Cart <span data-count>0</span></a><a href=\"/customer/pages/orders.html\">Orders</a><a href=\"/customer/pages/profile.html\">Account</a></nav></div></header><main class=\"container page\"><span class=\"eyebrow\">DELIVERY</span><h1>Track Order</h1><div id=\"track\" class=\"panel\"><form id=\"trackForm\"><label>Order ID<input id=\"orderId\" required placeholder=\"Your order ID\"></label><label>Delhivery AWB / Waybill<input id=\"awb\" placeholder=\"Enter AWB if available\"></label><button class=\"btn primary\">Track shipment</button></form><div id=\"trackResult\"></div></div><script>document.getElementById(\"trackForm\").addEventListener(\"submit\",async e=>{e.preventDefault();let id=document.getElementById(\"orderId\").value.trim(),awb=document.getElementById(\"awb\").value.trim();try{let o=await (await fetch(\"/api/orders/\"+encodeURIComponent(id))).json();if(!o.order)throw Error(o.error||\"Order not found\");if(!awb)awb=o.order.awb||\"\";let html=\"<h2>\"+o.order.id+\"</h2><p>Order status: <b>\"+o.order.status+\"</b></p>\";if(awb){let tr=await (await fetch(\"/api/track/\"+encodeURIComponent(awb))).json();if(tr.error)html+=\"<p class=error>\"+tr.error+\"</p>\";else html+=\"<h3>Delhivery shipment</h3><pre style=\"white-space:pre-wrap\">\"+JSON.stringify(tr.data,null,2)+\"</pre>\"}else html+=\"<p>Your Delhivery AWB will appear here after shipment is manifested.</p>\";document.getElementById(\"trackResult\").innerHTML=html}catch(x){document.getElementById(\"trackResult\").innerHTML=\"<p class=error>\"+x.message+\"</p>\"}});const qp=new URLSearchParams(location.search);if(qp.get(\"id\"))document.getElementById(\"orderId\").value=qp.get(\"id\");if(qp.get(\"awb\"))document.getElementById(\"awb\").value=qp.get(\"awb\");</script></main><footer class=\"footer\"><div class=\"container\"><b>🧶 WoollyCraft</b><p>Little handmade things, made to make you smile.</p></div></footer><nav class=\"mobile\"><a href=\"/\">🏠<br>Home</a><a href=\"/customer/pages/shop.html\">🛍<br>Shop</a><a href=\"/customer/pages/wishlist.html\">♡<br>Wish</a><a href=\"/customer/pages/cart.html\">🛒<br>Cart</a><a href=\"/customer/pages/profile.html\">👤<br>Account</a></nav><script src=\"/customer/components/store.js\"></script></body></html>",
        "wishlist": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Wishlist — WoollyCraft</title><link rel=\"stylesheet\" href=\"/customer/assets/store.css\"></head><body><header class=\"header\"><div class=\"container nav\"><a class=\"logo\" href=\"/\">🧶 WoollyCraft</a><nav class=\"navlinks\"><a href=\"/\">Home</a><a href=\"/customer/pages/shop.html\">Shop</a><a href=\"/customer/pages/wishlist.html\">♡ Wishlist</a><a href=\"/customer/pages/cart.html\">🛒 Cart <span data-count>0</span></a><a href=\"/customer/pages/orders.html\">Orders</a><a href=\"/customer/pages/profile.html\">Account</a></nav></div></header><main class=\"container page\"><span class=\"eyebrow\">WOOLLYCRAFT</span><h1>Wishlist</h1><div class=\"grid\" data-wishlist></div></main><footer class=\"footer\"><div class=\"container\"><b>🧶 WoollyCraft</b><p>Little handmade things, made to make you smile.</p></div></footer><nav class=\"mobile\"><a href=\"/\">🏠<br>Home</a><a href=\"/customer/pages/shop.html\">🛍<br>Shop</a><a href=\"/customer/pages/wishlist.html\">♡<br>Wish</a><a href=\"/customer/pages/cart.html\">🛒<br>Cart</a><a href=\"/customer/pages/profile.html\">👤<br>Account</a></nav><script src=\"/customer/components/store.js\"></script></body></html>",
        "profile": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>My Account — WoollyCraft</title><link rel=\"stylesheet\" href=\"/customer/assets/store.css\"><style>\n.account{display:grid;grid-template-columns:240px 1fr;gap:24px}.account-side,.account-card{background:#fff;border:1px solid #eadfd8;border-radius:20px;padding:20px;box-shadow:0 8px 25px rgba(74,48,38,.05)}.account-side a{display:block;padding:10px 12px;border-radius:10px;color:#756b66;text-decoration:none;font-weight:700}.account-side a:hover{background:#f5ebe6;color:#8b5e4d}.profile-head{display:flex;align-items:center;gap:16px}.avatar{width:72px;height:72px;border-radius:50%;display:grid;place-items:center;background:#f3e5df;font-size:34px;overflow:hidden}.avatar img{width:100%;height:100%;object-fit:cover}.summary-grid,.quick-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.quick-grid{grid-template-columns:repeat(3,1fr)}.mini{padding:15px;border:1px solid #eadfd8;border-radius:14px;background:#fffaf7}.mini b,.mini span{display:block}.mini span{font-size:12px;color:#756b66;margin-top:4px}.quick{display:flex;align-items:center;gap:10px;text-decoration:none;color:#2d2522}.order-line{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}.timeline{display:flex;justify-content:space-between;gap:8px;margin-top:15px;padding-top:14px;border-top:1px solid #eadfd8;font-size:11px}.timeline span{color:#b3a7a1}.timeline .done{color:#8b5e4d;font-weight:800}.account-alert{position:sticky;top:70px;z-index:10;background:#fff2d9;border:1px solid #edd2a4;color:#6c4b18;padding:12px 16px;border-radius:14px;margin-bottom:18px;display:flex;justify-content:space-between;gap:12px;align-items:center}.account-alert.hidden{display:none}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.form-grid input,.form-grid textarea{width:100%;padding:12px;border:1px solid #eadfd8;border-radius:10px;background:#fff;font:inherit}.form-grid textarea{grid-column:1/-1;min-height:90px}.product-mini{display:flex;gap:10px;align-items:center}.product-mini img{width:58px;height:58px;border-radius:12px;object-fit:cover}.account-section{margin-top:20px}.empty-mini{padding:18px;text-align:center;color:#756b66;background:#fffaf7;border-radius:12px}.mobile{display:none}@media(max-width:850px){.account{grid-template-columns:1fr}.account-side{display:none}.summary-grid,.quick-grid{grid-template-columns:repeat(2,1fr)}.mobile{display:flex;position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid #eadfd8;z-index:30;justify-content:space-around;padding:8px}.mobile a{font-size:11px;text-align:center;text-decoration:none;color:#756b66}.form-grid{grid-template-columns:1fr}.form-grid textarea{grid-column:auto}}\n</style></head><body>\n<header class=\"header\"><div class=\"container nav\"><a class=\"logo\" href=\"/\">🧶 WoollyCraft</a><nav class=\"navlinks\"><a href=\"/\">Home</a><a href=\"/customer/pages/shop.html\">Shop</a><a href=\"/customer/pages/wishlist.html\">♡ Wishlist</a><a href=\"/customer/pages/cart.html\">🛒 Cart <span data-count>0</span></a><a href=\"/customer/pages/orders.html\">Orders</a><a href=\"/customer/pages/profile.html\">Account</a></nav></div></header>\n<main class=\"container page\"><div id=\"profileAlert\" class=\"account-alert\"><span>✨ Complete your account details so your orders, delivery information and checkout details are easier to manage.</span><button class=\"btn light\" onclick=\"document.getElementById('name').focus()\">Complete now</button></div>\n<div class=\"account\"><aside class=\"account-side\"><div class=\"profile-head\"><div class=\"avatar\" id=\"avatarSide\">🧶</div><div><b id=\"sideName\">Your account</b><small id=\"sidePhone\">Save your details</small></div></div><hr><a href=\"#dashboard\">Dashboard</a><a href=\"#orders\">My Orders</a><a href=\"/customer/pages/track-order.html\">Track Order</a><a href=\"/customer/pages/wishlist.html\">Wishlist</a><a href=\"#reviews\">My Reviews</a><a href=\"/customer/pages/support.html\">Help & Support</a></aside>\n<section><section id=\"dashboard\" class=\"account-card\"><div class=\"profile-head\"><div class=\"avatar\" id=\"avatar\">🧶</div><div><span class=\"eyebrow\">MY ACCOUNT</span><h1 id=\"welcome\" style=\"margin:3px 0\">Welcome!</h1><p id=\"contact\" class=\"muted\">Add your details below.</p></div></div><div class=\"summary-grid\" style=\"margin-top:18px\"><div class=\"mini\"><b id=\"totalOrders\">0</b><span>Total orders</span></div><div class=\"mini\"><b id=\"activeOrders\">0</b><span>Active orders</span></div><div class=\"mini\"><b id=\"wishCount\">0</b><span>Wishlist</span></div><div class=\"mini\"><b id=\"reviewCount\">0</b><span>Reviews</span></div><div class=\"mini\"><b id=\"deliveredOrders\">0</b><span>Delivered</span></div><div class=\"mini\"><b id=\"spent\">₹0</b><span>Total spent</span></div></div><h2 class=\"account-section\">Quick actions</h2><div class=\"quick-grid\"><a class=\"mini quick\" href=\"#orders\">📦 <b>My Orders</b></a><a class=\"mini quick\" href=\"/customer/pages/track-order.html\">🚚 <b>Track Order</b></a><a class=\"mini quick\" href=\"/customer/pages/wishlist.html\">♡ <b>Wishlist</b></a><a class=\"mini quick\" href=\"#reviews\">⭐ <b>Reviews</b></a></div></section>\n<section id=\"active\" class=\"account-card account-section\"><h2>📦 Active order</h2><div id=\"activeOrder\" class=\"empty-mini\">No active orders right now.</div></section>\n<section id=\"orders\" class=\"account-card account-section\"><div class=\"order-line\"><h2>My Orders</h2><a class=\"btn light\" href=\"/customer/pages/orders.html\">View all</a></div><div id=\"ordersList\" class=\"empty-mini\">Loading orders…</div></section>\n<section class=\"account-card account-section\"><h2>❤️ Wishlist</h2><div id=\"wishlistBox\" class=\"empty-mini\">No saved products yet.</div></section>\n\n\n<section id=\"reviews\" class=\"account-card account-section\"><h2>⭐ My Reviews</h2><div class=\"empty-mini\">Your purchased products will appear here when reviews are available.</div></section>\n\n\n\n</section></div></main><footer class=\"footer\"><div class=\"container\"><b>🧶 WoollyCraft</b><p>Little handmade things, made to make you smile.</p></div></footer><nav class=\"mobile\"><a href=\"/\">🏠<br>Home</a><a href=\"/customer/pages/shop.html\">🛍<br>Shop</a><a href=\"/customer/pages/wishlist.html\">♡<br>Wish</a><a href=\"/customer/pages/cart.html\">🛒<br>Cart</a><a href=\"/customer/pages/profile.html\">👤<br>Profile</a></nav><script src=\"/customer/components/store.js\"></script><script>\nconst cid=localStorage.woolly_customer_id||(crypto.randomUUID?crypto.randomUUID():'wc_'+Date.now());localStorage.woolly_customer_id=cid;let orders=[];const A=id=>document.getElementById(id),M=n=>'₹'+Number(n||0).toLocaleString('en-IN');\nasync function loadAccount(){try{const p=await (await fetch('/api/customer/profile?customerId='+encodeURIComponent(cid))).json();const o=await (await fetch('/api/customer/orders?customerId='+encodeURIComponent(cid))).json();const x=p.profile||{};A('sideName').textContent=x.name||'Your account';A('sidePhone').textContent=x.phone||'Your account';A('welcome').textContent=x.name?`Welcome, ${x.name}!`:'Welcome!';A('contact').textContent=x.email||x.phone||'Your orders and account information';orders=o.orders||[];renderOrders();renderWishlist();}catch(e){console.error(e)}}\nfunction renderOrders(){A('totalOrders').textContent=orders.length;A('activeOrders').textContent=orders.filter(o=>!['delivered','cancelled'].includes(o.status)).length;A('deliveredOrders').textContent=orders.filter(o=>o.status==='delivered').length;A('spent').textContent=M(orders.reduce((s,o)=>s+Number(o.total||o.amount||0),0));A('ordersList').innerHTML=orders.length?orders.slice(0,5).map(o=>`<div class=\"mini\" style=\"margin-bottom:8px\"><div class=\"order-line\"><b>${o.id}</b><b>${M(o.total||o.amount)}</b></div><span>${o.status||'confirmed'} · ${new Date(o.createdAt).toLocaleDateString('en-IN')}</span><div style=\"margin-top:8px\"><a class=\"btn light\" href=\"/customer/pages/orders.html?id=${encodeURIComponent(o.id)}\">View order</a><a class=\"btn light\" href=\"/customer/pages/track-order.html?id=${encodeURIComponent(o.id)}\">Track</a></div></div>`).join(''):'<div class=\"empty-mini\">No orders yet. Start shopping!</div>';let a=orders.find(o=>!['delivered','cancelled'].includes(o.status));A('activeOrder').innerHTML=a?`<div class=\"order-line\"><div><b>${a.id}</b><span class=\"muted\">${a.items?.length||0} item(s) · ${M(a.total||a.amount)}</span></div><a class=\"btn primary\" href=\"/customer/pages/orders.html?id=${encodeURIComponent(a.id)}\">View order</a></div>`:'No active orders right now.'}\nfunction renderWishlist(){let w=JSON.parse(localStorage.woolly_wish||'[]');A('wishCount').textContent=w.length;A('wishlistBox').innerHTML=w.length?`${w.length} saved product(s). <a href=\"/customer/pages/wishlist.html\">View wishlist →</a>`:'No saved products yet.'}\nloadAccount();\n</script></script></body></html>\n",
