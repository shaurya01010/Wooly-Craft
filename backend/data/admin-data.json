      "html": {
        "home": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><meta name=\"theme-color\" content=\"#fbf7f4\"><title>WoollyCraft — Handmade with Love</title><link rel=\"stylesheet\" href=\"/customer/assets/store.css\"></head>\n<body>\n<div class=\"announce\">✨ Handmade with love · Cute gifts · ₹49 delivery · Secure checkout</div>\n<header class=\"header\"><div class=\"container nav\"><a class=\"logo\" href=\"/\">🧶 WoollyCraft</a><nav class=\"navlinks\"><a href=\"/\">Home</a><a href=\"/customer/pages/shop.html\">Shop</a><a href=\"/customer/pages/shop.html\">Categories</a><a href=\"/customer/pages/shop.html?sort=offers\">Offers</a><a href=\"/customer/pages/wishlist.html\">♡ Wishlist</a><a href=\"/customer/pages/cart.html\">🛒 Cart <span data-count>0</span></a><a href=\"/customer/pages/profile.html\">Account</a></nav></div></header>\n<main class=\"container page\">\n<section class=\"home-search\"><form onsubmit=\"homeSearch(event)\"><input id=\"homeSearch\" placeholder=\"Search keychains, clips, gifts or product number…\"><button class=\"btn primary\">Search</button></form><div class=\"search-hints\">Popular: <button onclick=\"quickSearch('keychain')\">Keychains</button><button onclick=\"quickSearch('clips')\">Clips</button><button onclick=\"quickSearch('gift')\">Gifts</button></div></section>\n<section class=\"hero\"><div class=\"hero-card\"><div class=\"hero-copy\"><span class=\"eyebrow\">HANDMADE • CUTE • UNIQUE</span><h1>Little handmade things, <em>made to make you smile.</em></h1><p>Woolen keychains, hair clips and tiny gifts crafted with care.</p><a class=\"btn primary\" href=\"/customer/pages/shop.html\">Shop Now →</a></div><div class=\"hero-art\">🧶 🎀 🌸 ✨</div></div></section>\n<section class=\"section\"><div class=\"section-head\"><div><span class=\"eyebrow\">SHOP BY CATEGORY</span><h2>Find your little favourite</h2></div><a href=\"/customer/pages/shop.html\">View all →</a></div><div id=\"homeCategories\" class=\"category-grid\"></div></section>\n<section class=\"features\"><div class=\"feature\"><b>🧵 Handmade quality</b><span>Carefully crafted with attention to detail.</span></div><div class=\"feature\"><b>🎁 Cute gifts</b><span>Perfect little surprises for every occasion.</span></div><div class=\"feature\"><b>🔒 Secure checkout</b><span>Backend-verified payments and saved delivery.</span></div></section>\n<section class=\"section\"><div class=\"section-head\"><div><span class=\"eyebrow\">SHOP OUR PICKS</span><h2>Handmade highlights</h2></div><span class=\"slider-timer\">Auto • 1.5s</span></div><div class=\"home-slider\" id=\"homeSlider\"><button class=\"slider-arrow prev\" onclick=\"moveSlide(-1)\">‹</button><div class=\"slider-track\" id=\"sliderTrack\"></div><button class=\"slider-arrow next\" onclick=\"moveSlide(1)\">›</button><div class=\"slider-dots\" id=\"sliderDots\"></div></div></section>\n<section class=\"section price-section\"><div class=\"section-head\"><div><span class=\"eyebrow\">SHOP BY BUDGET</span><h2>Cute finds for every budget</h2></div></div><div class=\"budget-grid\" id=\"priceBuckets\"></div></section>\n<section class=\"section home-section\" id=\"flashSection\"><div class=\"section-head\"><div><span class=\"eyebrow\">LIMITED TIME</span><h2>💥 Flash Sale</h2></div><div id=\"flashCountdown\" class=\"sale-countdown\"></div></div><div id=\"flashProducts\" class=\"grid\"></div></section>\n<section class=\"section home-section\"><div class=\"section-head\"><div><span class=\"eyebrow\">BEST SELLERS</span><h2>🏆 Loved by customers</h2></div><a href=\"/customer/pages/shop.html\">Shop all →</a></div><div id=\"bestProducts\" class=\"grid\"></div></section>\n<section class=\"section home-section\"><div class=\"section-head\"><div><span class=\"eyebrow\">TRENDING NOW</span><h2>🔥 Customer favourites</h2></div></div><div id=\"trendProducts\" class=\"grid\"></div></section>\n<section class=\"section home-section\"><div class=\"section-head\"><div><span class=\"eyebrow\">JUST ARRIVED</span><h2>🆕 New arrivals</h2></div></div><div id=\"newProducts\" class=\"grid\"></div></section>\n<section class=\"campaign\"><div><span class=\"eyebrow\">WOOLLYCRAFT GIFT COLLECTION</span><h2>Small gifts. Big smiles. 🎁</h2><p>Pick something handmade for someone special — or yourself.</p><a class=\"btn primary\" href=\"/customer/pages/shop.html\">Explore gifts →</a></div><div class=\"campaign-art\">🎀 🧶 🌷 💕</div></section>\n<section class=\"section home-section\"><div class=\"section-head\"><div><span class=\"eyebrow\">YOUR JOURNEY</span><h2>👀 Recently viewed</h2></div></div><div id=\"recentProducts\" class=\"grid\"></div></section>\n<section class=\"section home-section\"><div class=\"section-head\"><div><span class=\"eyebrow\">JUST FOR YOU</span><h2>💖 Recommended for you</h2></div></div><div id=\"recommendedProducts\" class=\"grid\"></div></section>\n<section class=\"section home-section\"><div class=\"section-head\"><div><span class=\"eyebrow\">COMPLETE THE LOOK</span><h2>🛍️ Frequently bought together</h2></div></div><div id=\"togetherProducts\" class=\"grid\"></div></section>\n<section class=\"brand-story\"><div><span class=\"eyebrow\">WHY WOOLLYCRAFT</span><h2>Made with love, one little stitch at a time.</h2><p>Every piece is made to feel personal, playful and gift-worthy — from cute woolen keychains to colourful clips and tiny handmade surprises.</p><a class=\"btn primary\" href=\"/customer/pages/shop.html\">Shop the collection →</a></div><div class=\"trust-cards\"><div>🧵<b>Handmade Quality</b><span>Carefully crafted</span></div><div>🎀<b>Made With Love</b><span>Thoughtful details</span></div><div>🎁<b>Cute Gifts</b><span>Ready to delight</span></div></div></section>\n<section class=\"section\"><div class=\"section-head\"><div><span class=\"eyebrow\">CUSTOMER LOVE</span><h2>⭐ What shoppers say</h2></div></div><div class=\"reviews-home\"><div>“So cute and beautifully made! The little details are adorable.”<b>Verified buyer ★★★★★</b></div><div>“Perfect as a small gift. Packaging and quality were lovely.”<b>Verified buyer ★★★★★</b></div><div>“I ordered again because the first one was even better in person.”<b>Verified buyer ★★★★★</b></div></div></section>\n<section class=\"service-strip\"><div>🔐<b>Secure payments</b><span>Razorpay verified checkout</span></div><div>📦<b>Order tracking</b><span>Track your delivery anytime</span></div><div>🧶<b>Handmade quality</b><span>Made with care</span></div><div>💬<b>Customer support</b><span>We're here to help</span></div></section>\n<section class=\"section\"><div class=\"section-head\"><div><span class=\"eyebrow\">EXPLORE MORE</span><h2>More handmade favourites</h2></div><a href=\"/customer/pages/shop.html\">View all →</a></div><div id=\"finalProducts\" class=\"grid\"></div></section>\n</main><footer class=\"footer\"><div class=\"container\"><b>🧶 WoollyCraft</b><p>Little handmade things, made to make you smile.</p></div></footer>\n<nav class=\"mobile\"><a href=\"/\">🏠<br>Home</a><a href=\"/customer/pages/shop.html\">🛍<br>Shop</a><a href=\"/customer/pages/wishlist.html\">♡<br>Wish</a><a href=\"/customer/pages/cart.html\">🛒<br>Cart</a><a href=\"/customer/pages/profile.html\">👤<br>Profile</a></nav>\n<script src=\"/customer/components/store.js\"></script><script>\nfunction homeSearch(e){e.preventDefault();let q=document.getElementById('homeSearch').value.trim();location.href='/customer/pages/shop.html'+(q?'?q='+encodeURIComponent(q):'')}\nfunction quickSearch(q){location.href='/customer/pages/shop.html?q='+encodeURIComponent(q)}\nfunction homeCard(p){return `<article class=\"card\"><div class=\"card-img\"><img loading=\"lazy\" src=\"${esc(img(p))}\" alt=\"${esc(p.name)}\"><span class=\"pill\">${esc(p.badge||'HANDMADE')}</span><button class=\"heart\" onclick=\"toggleWish('${esc(p.id)}')\">${wish.includes(p.id)?'♥':'♡'}</button></div><div class=\"card-body\"><h3>${esc(p.name)}</h3><small class=\"sku\">Product No: ${esc(p.sku||'—')}</small><p>${esc(p.description||'Handmade with care.')}</p><span class=\"price\">${money(p.price)}</span>${p.originalPrice?`<span class=\"old\">${money(p.originalPrice)}</span>`:''}<div class=\"card-actions\"><button class=\"btn light\" onclick=\"add('${esc(p.id)}')\">Add to cart</button><a class=\"btn primary\" href=\"/customer/pages/product.html?id=${encodeURIComponent(p.id)}\">View</a></div></div></article>`}\nfunction fill(id,arr){let e=document.getElementById(id);if(!e)return;e.innerHTML=arr.length?arr.slice(0,4).map(homeCard).join(''):'<div class=\"empty\">More handmade favourites are coming soon.</div>'}\nfunction categoryData(){let map={};PRODUCTS.filter(p=>p.active!==false).forEach(p=>{let c=p.category||'Other';if(!map[c])map[c]=p});let names=Object.keys(map).slice(0,6);document.getElementById('homeCategories').innerHTML=names.length?names.map(c=>`<a class=\"category-card\" href=\"/customer/pages/shop.html?category=${encodeURIComponent(c)}\"><div class=\"category-icon\"><img src=\"${esc(img(map[c]))}\" alt=\"\"></div><b>${esc(c)}</b><span>Shop collection →</span></a>`).join(''):'<div class=\"empty\">Categories will appear here.</div>'}\nfunction initPremiumHome(){if(typeof PRODUCTS==='undefined'||!PRODUCTS.length)return;categoryData();let active=PRODUCTS.filter(p=>p.active!==false), sorted=[...active].sort((a,b)=>(b.createdAt||0)-(a.createdAt||0));fill('bestProducts',active.filter(p=>p.badge==='BEST SELLER'||p.bestSeller||p.bestSelling).concat(active.filter(p=>p.badge!=='BEST SELLER'&&!p.bestSeller)).slice(0,4));fill('trendProducts',active.filter(p=>p.trending).concat(active).slice(0,4));fill('newProducts',sorted);fill('finalProducts',active);let recent=JSON.parse(localStorage.woolly_recent||'[]').map(id=>active.find(p=>String(p.id)===String(id))).filter(Boolean);fill('recentProducts',recent);let viewed=new Set(recent.map(p=>p.id)), rec=active.filter(p=>!viewed.has(p.id));let w=new Set(JSON.parse(localStorage.woolly_wish||'[]'));rec.sort((a,b)=>(w.has(b.id)?1:0)-(w.has(a.id)?1:0));fill('recommendedProducts',rec);fill('togetherProducts',active.filter(p=>p.category&&recent.some(r=>r.category===p.category)).concat(active).slice(0,4));let sale=active.filter(p=>p.originalPrice&&Number(p.originalPrice)>Number(p.price));fill('flashProducts',sale.length?sale:active.slice(0,4));let countdown=document.getElementById('flashCountdown'),end=Date.now()+6*60*60*1000;function tick(){let x=Math.max(0,end-Date.now()),h=Math.floor(x/36e5),m=Math.floor(x%36e5/6e4),s=Math.floor(x%6e4/1e3);countdown.textContent=`Ends in ${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`}tick();setInterval(tick,1000)}\ndocument.addEventListener('DOMContentLoaded',()=>setTimeout(initPremiumHome,700));\n</script></body></html>\n",
        "shop": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#fbf7f4\">\n  <title>Shop — WoollyCraft</title>\n  <link rel=\"stylesheet\" href=\"/customer/assets/store.css\">\n</head>\n<body>\n<header class=\"header\">\n  <div class=\"container nav\">\n    <a class=\"logo\" href=\"/\">🧶 WoollyCraft</a>\n    <nav class=\"navlinks\">\n      <a href=\"/\">Home</a><a href=\"/customer/pages/shop.html\">Shop</a>\n      <a href=\"/customer/pages/wishlist.html\">♡ Wishlist</a>\n      <a href=\"/customer/pages/cart.html\">🛒 Cart <span data-count>0</span></a>\n      <a href=\"/customer/pages/orders.html\">Orders</a><a href=\"/customer/pages/profile.html\">Account</a>\n    </nav>\n  </div>\n</header>\n\n<main class=\"container page\">\n  <span class=\"eyebrow\">WOOLLYCRAFT</span>\n  <h1>Shop handmade</h1>\n  <p>Keychains, clips, charms and cute little gifts.</p>\n\n  <div class=\"toolbar shop-toolbar\">\n    <input class=\"search\" data-search oninput=\"render()\" placeholder=\"Search name, category or Product No. e.g. WC-KC-001\" autocomplete=\"off\">\n    <div class=\"filters\">\n      <select data-cat onchange=\"render()\"><option value=\"all\">All categories</option></select>\n      <select data-price onchange=\"render()\"><option value=\"all\">All prices</option></select>\n      <select data-sort onchange=\"render()\">\n        <option value=\"featured\">Recommended</option>\n        <option value=\"new\">Newest</option>\n        <option value=\"low\">Price low → high</option>\n        <option value=\"high\">Price high → low</option>\n      </select>\n    </div>\n  </div>\n\n  <div id=\"shopNotice\" class=\"shop-notice hidden\"></div>\n  <div class=\"grid\" data-shop></div>\n</main>\n\n<footer class=\"footer\"><div class=\"container\"><b>🧶 WoollyCraft</b><p>Little handmade things, made to make you smile.</p></div>